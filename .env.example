# Copy to .env and fill in. Never commit .env.

# Which provider to use:
# - "groq" (Groq Cloud API - fast & generous free tier: https://console.groq.com/keys)
# - "local" (default offline, zero quota, 0 tokens needed)
# - "ollama" (locally running Ollama instance)
# - "huggingface" (Hugging Face API)
# - "google" (Gemini API)
LLM_PROVIDER=groq

# Groq API key (free at https://console.groq.com/keys, only if LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_your-groq-api-key-here

# Hugging Face token (from https://huggingface.co/settings/tokens, only if LLM_PROVIDER=huggingface)
HF_TOKEN=your-huggingface-token-here

# Gemini API key (create one in Google AI Studio, only if LLM_PROVIDER=google)
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional Ollama configuration (if LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Model name:
# For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# For local: blackbox-local-offline
# For Ollama: llama3.2, mistral, qwen2.5:3b
# For Hugging Face: meta-llama/Llama-3.1-8B-Instruct
# For Google: gemini-flash-latest, gemini-2.5-flash
LLM_MODEL=llama-3.3-70b-versatile

# Sampling temperature. Optional: defaults to 0 for reproducible runs.
LLM_TEMPERATURE=0

# Optional: point the tools at a different product file (useful for failure injection later).
# PRODUCTS_PATH=data/products.json
