# Copy to .env and fill in. Never commit .env.

# Which provider to use. "google" = Gemini via langchain-google-genai.
LLM_PROVIDER=google

# Gemini API key (create one in Google AI Studio).
GOOGLE_API_KEY=your-gemini-api-key-here

# Model name. Optional: defaults to gemini-2.5-flash for the google provider.
LLM_MODEL=gemini-2.5-flash

# Sampling temperature. Optional: defaults to 0 for reproducible runs.
LLM_TEMPERATURE=0

# Optional: point the tools at a different product file (useful for failure injection later).
# PRODUCTS_PATH=data/products.json
