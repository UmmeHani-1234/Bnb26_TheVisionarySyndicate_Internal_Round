# Copy to .env and fill in. Never commit .env.

# Which provider to use: "huggingface" or "google".
LLM_PROVIDER=huggingface

# Hugging Face token (from https://huggingface.co/settings/tokens)
HF_TOKEN=your-huggingface-token-here

# Gemini API key (create one in Google AI Studio).
GOOGLE_API_KEY=your-gemini-api-key-here

# Model name:
# For Hugging Face: meta-llama/Llama-3.1-8B-Instruct, Qwen/Qwen2.5-72B-Instruct
# For Google: gemini-flash-latest, gemini-2.5-flash
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Sampling temperature. Optional: defaults to 0 for reproducible runs.
LLM_TEMPERATURE=0

# Optional: point the tools at a different product file (useful for failure injection later).
# PRODUCTS_PATH=data/products.json
